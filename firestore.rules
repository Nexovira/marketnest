rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'ummuunaysah2006@gmail.com' ||
        request.auth.token.email == 'system.service@marketnest.app' ||
        request.auth.uid == 'jIL6hTLRLJhHyptlcvh0ciLc7Zp1'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        isPlatformOwner() ||
        (exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/adminProfiles/$(request.auth.uid)).data.role in ['super_admin', 'admin', 'operations_admin', 'finance_admin', 'support_admin', 'moderator']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin'])
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Platform Governance & Settings
    match /platformSettings/{settingId} {
      allow read: if true; // Public can inspect currency, maintenanceMode
      allow write: if isAdmin(); // Server-authoritative and super admin only
    }

    // Admin Profiles & Governance (Strict server, platform owner, and admin only)
    match /adminProfiles/{adminId} {
      allow get: if isSignedIn() && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(adminId) && (isPlatformOwner() || isAdmin());
      allow update: if (isSignedIn() && isOwner(adminId) && isPlatformOwner()) || isAdmin();
      allow delete: if false;
    }

    // Audit Logs (Append-only immutable audit trail)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // User account documents
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
                    && incoming().id == userId
                    && (!('role' in incoming()) || incoming().role == 'customer' || (incoming().role in ['admin', 'super_admin'] && isPlatformOwner()));

      allow update: if (isOwner(userId)
                    && incoming().id == userId
                    && (!('role' in incoming()) || incoming().role == existing().role || (incoming().role in ['admin', 'super_admin'] && isPlatformOwner())))
                    || isAdmin();

      allow delete: if false;

      // Customer subcollections
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }

      match /wishlist/{productId} {
        allow read, write: if isOwner(userId);
      }

      match /cart/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Seller profiles (Publicly viewable for verified storefronts; updated only by owner)
    match /sellerProfiles/{userId} {
      allow get, list: if true;

      allow create: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().status == 'pending'
                    && incoming().verified == false;

      // Seller cannot self-elevate verification or status
      allow update: if (isOwner(userId)
                    && incoming().userId == userId
                    && incoming().status == existing().status
                    && incoming().verified == existing().verified)
                    || isAdmin();

      allow delete: if false;
    }

    // Seller Applications
    match /sellerApplications/{applicationId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Marketplace Taxonomy Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /marketplaceCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Multi-Vendor Products
    match /products/{productId} {
      // Public can read products for marketplace browsing
      allow get, list: if true;

      // Only authenticated sellers can create products linked to their sellerId
      allow create: if isSignedIn()
                    && incoming().sellerId == request.auth.uid;

      // Seller can update their product, or inventory stock can be reserved upon order placement
      allow update: if isSignedIn() && (
        (resource.data.sellerId == request.auth.uid && incoming().sellerId == request.auth.uid) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'stockCount', 'inStock', 'status', 'updatedAt'])) ||
        isAdmin()
      );

      // Only the owning seller or admin can delete/archive their product
      allow delete: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }

    // Customer Unified Orders
    match /orders/{orderId} {
      // Visible to customer who bought or platform admin
      allow get, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Customer can create an escrow order in pending state only
      allow create: if isSignedIn() && (
        (incoming().customerId == request.auth.uid || incoming().userId == request.auth.uid) &&
        incoming().paymentStatus == 'pending'
      );

      // Customer can only cancel eligible orders (pending or confirmed)
      allow update: if (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ) && (
        incoming().orderStatus == 'cancelled' &&
        (existing().orderStatus == 'pending' || existing().orderStatus == 'confirmed') &&
        incoming().total == existing().total &&
        incoming().paymentStatus == existing().paymentStatus
      )) || isAdmin();

      allow delete: if false;
    }

    // Seller-Specific Order Groups for Fulfillment
    match /sellerOrders/{sellerOrderId} {
      // Seller who fulfills, buyer who ordered, or admin can view
      allow get, list: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Created atomically as part of customer checkout
      allow create: if isSignedIn();

      // Seller updates fulfillment status (e.g. pending -> confirmed -> processing -> shipped -> delivered)
      // Seller CANNOT change paymentStatus or subtotal
      allow update: if (isSignedIn() &&
        resource.data.sellerId == request.auth.uid &&
        incoming().sellerId == request.auth.uid &&
        incoming().subtotal == existing().subtotal &&
        incoming().paymentStatus == existing().paymentStatus) || isAdmin();

      allow delete: if false;
    }

    // Order Line Items (Immutable Historical Snapshot)
    match /orderItems/{orderItemId} {
      allow get, list: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Authoritative Payments (Read-only to owner, writes restricted to server)
    match /payments/{paymentId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    // Payment Attempts (Read-only to customer, server-managed)
    match /paymentAttempts/{attemptId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /orders/{orderId}/paymentAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Verified Seller Earnings (Accessible only by the earning merchant or admin)
    match /sellerEarnings/{earningId} {
      allow get, list: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    // =========================================================================
    // Phase 6: Affiliate Platform Security Rules
    // =========================================================================

    // Affiliate Profiles
    match /affiliateProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().status == 'pending'
                    && incoming().commissionRate == 0.05;

      // Affiliates can update display profile info, but CANNOT self-elevate commissionRate, status, or code
      allow update: if (isOwner(userId)
                    && incoming().userId == userId
                    && incoming().code == existing().code
                    && incoming().commissionRate == existing().commissionRate
                    && incoming().status == existing().status) || isAdmin();

      allow delete: if false;
    }

    // Affiliate Applications (Submitted by registered user, reviewed by admin)
    match /affiliateApplications/{applicationId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'rejected' &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending'
      );
      allow delete: if isAdmin();
    }

    // Affiliate Campaigns (Read-only for all authenticated affiliates)
    match /affiliateCampaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Affiliate Referral Links (Owned by affiliate)
    match /affiliateLinks/{linkId} {
      allow get, list: if isSignedIn() && (
        resource.data.affiliateId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && incoming().affiliateId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.affiliateId == request.auth.uid
                    && incoming().affiliateId == request.auth.uid
                    && incoming().code == existing().code;
      allow delete: if false;
    }

    // Affiliate Clicks (Tracking records created on referral click or server proxy)
    match /affiliateClicks/{clickId} {
      allow create: if true;
      allow get, list: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Affiliate Conversions (Strictly server-generated upon verified paid order)
    match /affiliateConversions/{conversionId} {
      allow get, list: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Affiliate Commissions (Strictly server-generated; read-only to affiliate)
    match /affiliateCommissions/{commissionId} {
      allow get, list: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Affiliate Payout Foundation
    match /affiliatePayouts/{payoutId} {
      allow get, list: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // ======================================================================
    // PHASE 8: ADVANCED MARKETPLACE RULES
    // ======================================================================

    // Product Reviews
    match /reviews/{reviewId} {
      allow get, list: if true;
      // Customer cannot self-label verifiedPurchase without server validation
      allow create: if isSignedIn()
                    && incoming().customerId == request.auth.uid
                    && incoming().verifiedPurchase == false;

      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid &&
        incoming().customerId == request.auth.uid &&
        incoming().sellerId == existing().sellerId &&
        incoming().verifiedPurchase == existing().verifiedPurchase
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // Seller Review Responses
    match /reviewResponses/{responseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid
                    && incoming().sellerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Product Questions & Answers
    match /productQuestions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    match /productAnswers/{answerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().answererId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.answererId == request.auth.uid || isAdmin());
    }

    // Store Followers
    match /storeFollowers/{followId} {
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.customerId == request.auth.uid;
      allow update: if false;
    }

    // Customer In-App Notifications
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid) || isAdmin()
      );
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Customer Returns & Refund Requests
    match /returns/{returnId} {
      allow get, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;
    }

    // Marketplace Promotions & Coupons (Publicly read active coupons, write by server/admin)
    match /promotions/{promotionId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Customer-Seller Direct Messaging
    match /conversations/{conversationId} {
      allow get, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().customerId == request.auth.uid ||
        incoming().sellerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Customer Loyalty Rewards (Server-managed, read-only to account owner)
    match /loyaltyAccounts/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow write: if false;
    }

    match /loyaltyTransactions/{transactionId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ======================================================================
    // PHASE 10: SUPPORT TICKETS & TRUST OPERATIONS
    // ======================================================================

    // Customer Support Tickets
    match /supportTickets/{ticketId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (
          (resource.data.isInternalNote != true) || isAdmin()
        );
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Marketplace Moderation Reports
    match /marketplaceReports/{reportId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Phase 17: Marketing Automation, CRM & Customer Retention
    match /marketingCampaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    match /marketingSegments/{segmentId} {
      allow read, write: if isAdmin();
    }

    match /marketingPreferences/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /abandonedCarts/{cartId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /automationJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /marketingTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /campaignAttributions/{attributionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
